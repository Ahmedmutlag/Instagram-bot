{
  "name": "smm-reseller-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Backend for the Telegram SMM reseller platform (API + Bot + Workers)",
  "license": "UNLICENSED",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev:api": "ts-node-dev --respawn --transpile-only src/api/server.ts",
    "dev:bot": "ts-node-dev --respawn --transpile-only src/bot/index.ts",
    "dev:worker": "ts-node-dev --respawn --transpile-only src/workers/index.ts",
    "dev:bot-worker": "ts-node-dev --respawn --transpile-only src/combinedBotWorker.ts",
    "start:api": "node dist/src/api/server.js",
    "start:bot": "node dist/src/bot/index.js",
    "start:worker": "node dist/src/workers/index.js",
    "start:bot-worker": "node dist/src/combinedBotWorker.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:seed": "ts-node prisma/seed.ts",
    "test": "jest --runInBand",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@prisma/client": "^5.19.1",
    "axios": "^1.7.7",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.12.12",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.2",
    "nanoid": "^3.3.7",
    "pino": "^9.4.0",
    "pino-http": "^10.3.0",
    "prisma": "^5.19.1",
    "telegraf": "^4.16.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^20.16.5",
    "@types/supertest": "^6.0.2",
    "jest": "^29.7.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.5.4"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  }
}
