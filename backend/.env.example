# Backend-only environment variables (used when running the API/bot/worker
# directly with `npm run dev:*`, outside Docker). When using
# `docker compose up`, configure the root-level `.env` file instead.

NODE_ENV=development
DATABASE_URL=postgresql://smm_user:change_me_strong_password@localhost:5432/smm_bot
REDIS_URL=redis://localhost:6379

TELEGRAM_BOT_TOKEN=REPLACE_WITH_YOUR_TELEGRAM_BOT_TOKEN

JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET
JWT_EXPIRES_IN=12h

# 32-byte key as a 64-character hex string. Generate with: openssl rand -hex 32
ENCRYPTION_KEY=REPLACE_WITH_A_64_CHAR_HEX_STRING

API_PORT=4000
ADMIN_CORS_ORIGIN=http://localhost:3000
DEFAULT_CURRENCY=USD

# Used only by prisma/seed.ts to create the first admin account.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=ChangeMe123!
