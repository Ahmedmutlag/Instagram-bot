# Copy this file to `.env` in the project root before running
# `docker compose up`. Do NOT commit the real `.env` file or real secrets.

# ---------------------------------------------------------------------------
# PostgreSQL (used by docker-compose to provision the `postgres` service)
# ---------------------------------------------------------------------------
POSTGRES_USER=smm_user
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=smm_bot
POSTGRES_PORT=5432

# Full connection string used by the backend (api/bot/worker). When running
# via docker-compose this is overridden automatically to point at the
# `postgres` service — only relevant for running the backend outside Docker.
DATABASE_URL=postgresql://smm_user:change_me_strong_password@localhost:5432/smm_bot

# ---------------------------------------------------------------------------
# Redis (BullMQ background jobs + bot session storage)
# ---------------------------------------------------------------------------
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# ---------------------------------------------------------------------------
# Telegram
# ---------------------------------------------------------------------------
# Create a bot with @BotFather on Telegram and paste its token here.
TELEGRAM_BOT_TOKEN=REPLACE_WITH_YOUR_TELEGRAM_BOT_TOKEN

# ---------------------------------------------------------------------------
# Security
# ---------------------------------------------------------------------------
# Secret used to sign admin JWT sessions. Use a long random string.
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET
JWT_EXPIRES_IN=12h

# AES-256 key (32 bytes) used to encrypt provider API keys at rest.
# Generate one with: openssl rand -hex 32
ENCRYPTION_KEY=REPLACE_WITH_A_64_CHAR_HEX_STRING

# ---------------------------------------------------------------------------
# API / Admin dashboard
# ---------------------------------------------------------------------------
API_PORT=4000
ADMIN_PORT=3000
# Origin(s) allowed to call the admin REST API from a browser.
ADMIN_CORS_ORIGIN=http://localhost:3000
# Base URL the admin dashboard uses to reach the backend API (baked into the
# Next.js build — rebuild the `admin` image if you change this).
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1

DEFAULT_CURRENCY=USD
NODE_ENV=production

# ---------------------------------------------------------------------------
# Initial admin account (created once by the seed script, safe to remove
# after first run — change the password immediately after logging in)
# ---------------------------------------------------------------------------
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=ChangeMe123!
